@model List<laba11.Models.Book>
@{
    ViewData["Title"] = "Книги автора";
}
<h2>Результат поиска</h2>
@if (Model.Count == 0)
{
    <p>Нет книг данного автора.</p>
}
else
{
    <table border="1" cellpadding="5">
        <tr><th>Название</th><th>Страниц</th><th>Год</th></tr>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Title</td>
                <td>@b.Pages</td>
                <td>@b.Year</td>
            </tr>
        }
    </table>
}
<p><a href="/Books/SearchByAuthor">Новый поиск</a></p>