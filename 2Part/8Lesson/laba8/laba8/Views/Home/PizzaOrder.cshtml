@{
    Layout = null;
    ViewData["Title"] = "Заказ пиццы";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: inline-block;
            width: 120px;
            font-weight: bold;
        }

        input, textarea {
            width: 250px;
        }

        .status {
            margin-left: 10px;
        }

        .error {
            color: red;
        }

        .success {
            color: green;
        }

        .info {
            color: orange;
        }

        button {
            padding: 6px 12px;
            font-size: 14px;
        }

        input:read-only, textarea:read-only {
            background-color: #f0f0f0;
        }
    </style>
</head>
<body>

    <h2>Заказ пиццы</h2>

    <div class="form-group">
        <label>Телефон:</label>
        <input type="text" id="phone" placeholder="8-111-456-78-90" />
        <span id="phoneStatus" class="status"></span>
    </div>

    <div class="form-group">
        <label>Заказ:</label>
        <textarea id="order" rows="3" placeholder="Пепперони, Маргарита..."></textarea>
    </div>

    <div class="form-group">
        <label>Адрес доставки:</label>
        <textarea id="address" rows="2" placeholder="Улица, дом, квартира"></textarea>
    </div>

    <div class="form-group">
        <button id="orderBtn">Заказать</button>
    </div>

    <div id="result"></div>

    <script>
        function validatePhone(phone) {
            return /^[\d\-+]{10,}$/.test(phone);
        }

        function setStatus(element, text, className) {
            element.textContent = text;
            element.classList.remove("error", "success", "info");
            if (className) element.classList.add(className);
        }

        const phoneInput = document.getElementById("phone");
        const phoneStatus = document.getElementById("phoneStatus");
        const addressField = document.getElementById("address");
        const orderField = document.getElementById("order");
        const orderBtn = document.getElementById("orderBtn");
        const resultDiv = document.getElementById("result");

        function setAddressReadonly(isReadonly) {
            addressField.readOnly = isReadonly;
        }

        phoneInput.addEventListener("change", function () {
            const phone = phoneInput.value.trim();
            if (phone === "") {
                addressField.value = "";
                setAddressReadonly(false);
                setStatus(phoneStatus, "", "");
                return;
            }
            if (!validatePhone(phone)) {
                setStatus(phoneStatus, "Неверный формат телефона", "error");
                addressField.value = "";
                setAddressReadonly(false);
                return;
            }
            setStatus(phoneStatus, "Проверка...", "info");

            fetch(`/api/api/getAddress?phone=${encodeURIComponent(phone)}`)
                .then(response => {
                    if (!response.ok) throw new Error("Ошибка сервера");
                    return response.text();
                })
                .then(address => {
                    addressField.value = address;
                    if (address === "") {
                        setStatus(phoneStatus, "Новый клиент", "info");
                        setAddressReadonly(false);   
                    } else {
                        setStatus(phoneStatus, "Адрес загружен", "success");
                        setAddressReadonly(true);   
                    }
                })
                .catch(error => {
                    setStatus(phoneStatus, "Ошибка сервера", "error");
                    setAddressReadonly(false);
                });
        });

        orderBtn.addEventListener("click", function () {
            const phone = phoneInput.value.trim();
            const orderDetails = orderField.value.trim();
            let address = addressField.value.trim();

            if (!validatePhone(phone)) {
                resultDiv.innerHTML = "<span class='error'>Неверный формат телефона</span>";
                return;
            }
            if (orderDetails === "" || address === "") {
                resultDiv.innerHTML = "<span class='error'>Заполните все поля</span>";
                return;
            }

            const orderData = {
                phone: phone,
                orderDetails: orderDetails,
                deliveryAddress: address
            };

            fetch("/api/api/placeOrder", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(orderData)
            })
                .then(response => {
                    if (!response.ok) throw new Error(`Ошибка ${response.status}`);
                    return response.text();
                })
                .then(msg => {
                    resultDiv.innerHTML = `<span class='success'>${msg}</span>`;

                    orderField.value = "";
                    phoneInput.value = "";
                    addressField.value = "";
                    setAddressReadonly(false);
                    setStatus(phoneStatus, "", "");
                })
                .catch(error => {
                    resultDiv.innerHTML = `<span class='error'>Ошибка: ${error.message}</span>`;
                });
        });
    </script>

</body>
</html>