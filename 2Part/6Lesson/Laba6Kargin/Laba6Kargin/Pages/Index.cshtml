@page
@model IndexModel
@{
    ViewData["Title"] = "Приветствие";
}

<h2>Введите ваше имя</h2>
<form method="post">
    <input type="text" name="username" placeholder="Ваше имя" required />
    <button type="submit">Поздороваться</button>
</form>

@if (!string.IsNullOrEmpty(Model.Greeting))
{
    <h3>@Model.Greeting</h3>
}