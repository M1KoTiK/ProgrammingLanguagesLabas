@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Регистрация</title>
    <style>body { font-family: Arial; margin: 40px; } .error { color: red; } input { margin: 5px; }</style>
</head>
<body>
    <h2>Регистрация</h2>
    @if (ViewBag.Error != null) { <div class="error">@ViewBag.Error</div> }
    <form method="post">
        <label>Логин (англ, цифры, min 6):</label><br />
        <input type="text" name="login" required /><br />
        <label>Пароль (англ, цифры, min 6):</label><br />
        <input type="password" name="password" required /><br />
        <label>Подтверждение пароля:</label><br />
        <input type="password" name="confirmPassword" required /><br />
        <button type="submit">Зарегистрироваться</button>
    </form>
    <p><a href="/Account/Login">Войти</a></p>
</body>
</html>